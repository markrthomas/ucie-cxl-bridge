# .claude/swarm.env — this repo's profile for the shared DV swarm kit (markrthomas/dv-swarm-kit).
# See the kit's templates/swarm.env.example for what each key means. Environment variables override these.

PROJECT=ucie-cxl-bridge
GH_REPO=markrthomas/ucie-cxl-bridge
DUT_TOP=cxl_ucie_bridge

RTL_DIR=src
TB_DIR=verification

DV_ENVS="sim cocotb credit"
GATE_TARGET=check
CI_TARGET=ci
CROSSCHECK_TARGET=
INFRA_TARGETS="formal"
HEAVY_TARGETS="coverage formal ci"

MUTATION_FILE=src/cxl_ucie_bridge.v
MUTATION_HINT="invert one valid/ready qualifier or corrupt one data bit on the main datapath"

RR_DIR=verification/random
RR_STATUS=bootstrap

METRICS=no
