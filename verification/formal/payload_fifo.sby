[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 48
cover: mode cover
cover: depth 72

[engines]
smtbmc

[script]
# Yosys cwd is <taskdir>/src; repo RTL is three levels up.
read_verilog -sv -DFORMAL ../../../../src/sync_fifo.v
read_verilog -sv -DFORMAL ../../payload_fifo_props.sv
prep -top sync_fifo
async2sync
